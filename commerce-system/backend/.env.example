# --- Database ---
DATABASE_URL=postgresql+psycopg2://commerce_user:commerce_pass@localhost:5432/commerce_db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (shared with core-platform; verify tokens issued by core-platform) ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# --- Storage (S3 / R2 abstraction) ---
STORAGE_PROVIDER=s3            # s3 | r2
STORAGE_BUCKET=commerce-invoices
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT_URL=          # set for R2, leave blank for AWS S3
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=       # optional CDN/public base for reading objects

# --- bKash (Tokenized Checkout) ---
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://your-domain.com/api/v1/payments/bkash/callback

# --- Nagad ---
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_CALLBACK_URL=https://your-domain.com/api/v1/payments/nagad/callback

# --- SSLCommerz ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_SUCCESS_URL=https://your-domain.com/api/v1/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=https://your-domain.com/api/v1/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=https://your-domain.com/api/v1/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=https://your-domain.com/api/v1/payments/sslcommerz/ipn

# --- App ---
ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:3000
